#!name=去广告
#!desc=大师兄影视、酷狗音乐、快手、前程无忧、拼多多、爱奇艺等 App 广告拦截，以及个推、AnyThink/TopOn、美团点评 CatFront 等广告 SDK 上报拦截
#!author=yjlsx
#!homepage=https://github.com/yjlsx/qx
#!date=2026-10-11

[rewrite_local]
# =====================
# 大师兄影视
# =====================
# 广告位下发(开屏/贴片/横幅)与行为日志上报
^https?:\/\/app2\.dsx\.ac\/(?:dsx|ndsx)\.php\/v\d+\/advert(\?.*)?$ url reject-200
^https?:\/\/app2\.dsx\.ac\/(?:dsx|ndsx)\.php\/v\d+\/logs(\?.*)?$ url reject-200

# =====================
# 通用广告 SDK
# =====================
# 个推 SDK 初始化/环境检测
^https?:\/\/ido\.getui\.net(:\d+)?\/sdk\/v2\/ued(\?.*)?$ url reject-200
# AnyThink/TopOn 广告上报
^https?:\/\/tk\.anythinktech\.com\/v1\/open\/tk(\?.*)?$ url reject-200
^https?:\/\/ujoy\.anythinktech\.com\/v1\/open\/da(\?.*)?$ url reject-200
# 美团点评 CatFront 前端监控
^https?:\/\/catfront\.dianping\.com\/batch(\?.*)?$ url reject-200

# =====================
# 酷狗音乐
# =====================
# 开屏广告图片
^https?:\/\/splashimgretrybssdl\.cloud\.kugou\.com\/ url reject-img
# 广告统计日志
^http:\/\/log\.stat\.kugou\.com\/mobile\/ad\.html url reject-200
# 酷狗直播广告
^https:\/\/fx\.service\.kugou\.com\/mfx-kugoulive\/ad\/ url reject-dict
# 广告平台下发
^https:\/\/gateway(retry)?\.kugou\.com\/adp\/ad\/ url reject-dict
# 广告网关
^https:\/\/gateway(retry)?\.kugou\.com\/ads\.gateway\/ url reject-dict
# 关注页信息流广告
^https:\/\/gateway(retry)?\.kugou\.com\/v\d\/feeds\/follow_feed_fallback url reject-dict
# 个人页音乐符号推广
^https:\/\/gateway(retry)?\.kugou\.com\/mstc\/musicsymbol\/v\d\/system\/profile url reject-dict
# 搜索框热词推广
^https:\/\/gateway(retry)?\.kugou\.com\/searchnofocus\/v\d\/search_no_focus_word url reject-dict
# 播放页气泡广告
^https:\/\/gateway(retry)?\.kugou\.com\/adp\/bubble\/v\d\/song_play url reject-dict
# 评论区广告入口
^https:\/\/gateway(retry)?\.kugou\.com\/singerdiscuss\/v\d\/entrance\/comment url reject-dict
# 通用推广广告
^https:\/\/gateway(retry)?\.kugou\.com\/r\/v\d\/general\/putin\/midad url reject-dict
# 音效页横幅广告
^https:\/\/gateway(retry)?\.kugou\.com\/ocean\/v\d\/sound\/banner url reject-dict
# 繁星直播间列表
^https:\/\/gzacshow\.kugou\.com\/mfanxing-home\/cdn\/room\/index\/list_v2 url reject-dict
# 繁星秀场头条
^https:\/\/gzacshow\.kugou\.com\/mfx-rt-show\/cdn\/mo\/show\/headline url reject-dict
# 一起唱信息推广
^https:\/\/m1fxgroup\.kugou\.com\/fxsing\/yqc\/alongInfo\/getUserAlongInfo url reject-dict
# 商城入口数据
^https:\/\/hwstore\.kugou\.com\/v\d\/get_store_data url reject-dict
# 专辑商城入口
^https:\/\/ep\.kugou\.com\/v\d\/album_shop\/get_entrance_info url reject-dict
# 标签页精简 - 移除 "AI帮唱"、"长相思2"、"K歌"、"小说"、"游戏"
^https:\/\/gateway(retry)?\.kugou\.com\/ocean\/v\d\/tab\/list_v\d url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/KuGou_tab_remove.js

# =====================
# 快手
# =====================
# 广告请求拦截
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/n\/ad\/ url reject-dict
# 附近页悬浮推广
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/n\/nearby\/widget\/info\? url reject-dict
# 任务中心上报
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/n\/taskCenter\/task\/report\? url reject-dict
# 直播卡片推广
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/n\/live\/feed\/info\/simplelive\/card\? url reject-dict
# 启动配置精简 - 移除换肤/侧边栏推广/精简我的页面
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/system\/startup\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/KuaiShou_startup.js
# 直播广场横幅移除
^https:\/\/(apissl|az\d-live|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/n\/live\/feed\/square\/refresh\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/KuaiShou_live_banner.js
# 信息流广告过滤
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/n\/feed\/(selection|selectionFast)\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/KuaiShou_feed_ad.js
# 用户主页推荐移除
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/n\/user\/profile\/v2\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/KuaiShou_profile.js
# 私信页运营推荐移除
^https:\/\/(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/im\/wd\/top\/navigation\/getRecommendedSession\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/KuaiShou_im_recommend.js

# =====================
# 前程无忧
# =====================
# 开屏广告
^https:\/\/appapi\.51jobapp\.com\/api\/market\/get_launch\.php\? url reject-dict
# 横幅广告
^https:\/\/cupid\.51jobapp\.com\/open\/operation\/get\/latest\/banner-list\? url reject-dict
# 首页二级配置推广
^https:\/\/cupid\.51jobapp\.com\/open\/51job-activities\/secJob\/queryHomeSecondConfigV2\? url reject-dict
# 职位详情页竞品推广
^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/detail\/sesame-competitive\/ url reject-dict
# 职位详情页用户权益推广
^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/job-detail\/user-rights\? url reject-dict
# 简历优化推广
^https:\/\/cupid\.51jobapp\.com\/open\/resume\/strategy\/resume-build\? url reject-dict
# 首页弹窗
^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\/ url reject-dict
# 职位推荐页信息流广告
^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/recommend\/job-tab-dynamic\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/51Job_recommend.js
# 用户任务推广
^https:\/\/cupid\.51jobapp\.com\/open\/user-task\/user\/task\/ url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/51Job_task.js
# 好职位页横幅
^https:\/\/cupid\.51jobapp\.com\/open\/tab\/good-job\/modules\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/51Job_banner.js

# =====================
# 拼多多
# =====================
# 未评价订单推广
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/unrated_order_for_unreceived_tab\? url reject-dict
# 订单列表标签推广
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/query_order_list_tabs_element\? url reject-dict
# 首页会场入口
^https:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/homepage\? url reject-dict
# 订单快递推广
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_express_group\? url reject-dict
# 搜索热词
^https:\/\/api\.pinduoduo\.com\/search_hotquery\? url reject-dict
# 聊天页资源推广
^https:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data\? url reject-dict
# 聊天页新消息推广
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/new_chat_group\? url reject-dict
# 商品详情页备选推荐
^https:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up\? url reject-dict
# 个人中心推广
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/personal\? url reject-dict
# 商品详情页引导
^https:\/\/api\.pinduoduo\.com\/api\/brand-olay\/goods_detail\/bybt_guide\? url reject-dict
# 追评推广
