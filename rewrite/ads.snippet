^https:\/\/api\.pinduoduo\.com\/api\/engels\/wait\/receive\/review\? url reject-dict
# 推荐推广
^https:\/\/api\.pinduoduo\.com\/api\/buffon\/nasus\/recommend\? url reject-dict
# 商品详情标签推广
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v2\/query\/goods_detail_with_tags\? url reject-dict
# 首页精简 - 移除横幅/图标/热词/精简底栏
^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/PDD_homepage.js
# 搜索结果推广
^https:\/\/api\.pinduoduo\.com\/search\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/PDD_search.js
# 个人中心精简
^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/PDD_personal.js
# 商品详情页底部推广
^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/PDD_oak.js
# 订单详情页商品推荐
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/PDD_order_detail.js
# 订单页营销横幅
^https:\/\/api\.pinduoduo\.com\/order\/ url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/PDD_order.js
# 订单列表增长提示
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/PDD_order_list.js
# 扫码取件页商品推荐及弹窗
^https:\/\/m\.pinduoduo\.net\/mdkd\/package\?from_app_scan url script-response-body https://raw.githubusercontent.com/fkingikelee/fkikelee/main/Resource/kelee/JavaScript/PinDuoDuo/PinDuoDuo_remove_ads.js

# =====================
# 爱奇艺
# =====================
# 青少年弹窗/初始化代理
^https?:\/\/iface2\.iqiyi\.com\/control\/3\.0\/init_proxy\? url reject-dict
# VIP互动弹窗
^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api\/v2\/show\? url reject-dict
# 视频互动数据
^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\? url reject-dict
# 视频接口代理
^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\? url reject-dict
# 弹窗控制
^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\? url reject-dict
# 首页精简 - 移除焦点图/信息流广告/统计
^https:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_home.js
# 分类页广告移除
^https:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/category_home\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_category.js
# 瀑布流广告移除
^https:\/\/cards\.iqiyi\.com\/waterfall(-plt)?\/3\.0\/feed\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_waterfall.js
# 播放器标签页精简
^https:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_player_tabs.js
# 评论区广告移除
^https?:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_comments.js
# 搜索页广告移除
^https:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/hot_query_search\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_search.js
# 底栏精简
^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/bottom_theme\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_bottom.js
# 顶部导航精简
^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/home_top_menu\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_top_menu.js
# 通用广告开关禁用
^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_switch.js
# 广告混合器拦截
^https?:\/\/(kjp|t7z)\.cupid\.iqiyi\.com\/mixer\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_mixer.js
# 搜索建议广告
^https?:\/\/search\.video\.iqiyi\.com\/q\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_search_suggest.js
# 我的页面精简
^https?:\/\/iface2\.iqiyi\.com\/aggregate\/3\.0\/getMyMenus\? url script-response-body https://raw.githubusercontent.com/yjlsx/qx/main/scripts/iQiYi_myMenus.js

[filter_local]
# 酷狗音乐 - 广告域名拦截
host, ads.service.kugou.com, reject
host, adstats.tencentmusic.com, reject
host, adsmind.gdtimg.com, reject
host, adserviceretry.kugou.com, reject
host, adserviceretry.kglink.cn, reject
host, ad.tencentmusic.com, reject
host, adservice.kugou.com, reject
host, splashimgretrybssdl.cloud.kugou.com, reject
# 拼多多 - 广告域名拦截
host, titan.pinduoduo.com, reject
host, xg.pinduoduo.com, reject
host, cdl-1.pddpic.com, reject
host, cdl-p2.pddpic.com, reject
host, cd-1.pddpic.com, reject
host, apm.pinduoduo.com, reject
host, th-b.pinduoduo.com, reject
host, ta.pinduoduo.com, reject
host, th.pinduoduo.com, reject
host, th-a.pinduoduo.com, reject
host, ta-a.pinduoduo.com, reject
host, meta.pinduoduo.com, reject
host, apm-a.pinduoduo.com, reject
# 爱奇艺 - 广告域名拦截
ip-cidr, 103.44.59.54/32, reject, no-resolve
ip-cidr, 111.63.147.158/32, reject, no-resolve
ip-cidr, 116.211.198.237/32, reject, no-resolve
host, api.iqiyi.com, reject
host, access.if.iqiyi.com, reject
# 爱奇艺 - cupid 广告域走直连(避免 MitM 冲突)
host-suffix, cupid.iqiyi.com, direct

[mitm]
hostname = app2.dsx.ac, catfront.dianping.com, gateway.kugou.com, gatewayretry.kugou.com, fx.service.kugou.com, hwstore.kugou.com, ep.kugou.com, gzacshow.kugou.com, m1fxgroup.kugou.com, log.stat.kugou.com, splashimgretrybssdl.cloud.kugou.com, apissl.gifshow.com, apissl.ksapisrv.com, az*-api.ksapisrv.com, az*-api-js.gifshow.com, az*-api-idc.ksapisrv.com, az*-live.ksapisrv.com, appapi.51jobapp.com, cupid.51jobapp.com, api.pinduoduo.com, m.pinduoduo.net, -i.vip.iqiyi.com, *.iqiyi.com
